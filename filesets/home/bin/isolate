#! /bin/env bash
source '/home/nestor/bin/std.lib'

# ---

{ # -- Help Text -- #

	cat <<-EOF | store-as usage
		Usage: $( script-name ) [COLOR]

		Starts an isolated session *in-pane* with a colored indicator.
		The default COLOR is 'cyan'.

		Available COLOR values are:
		- black      - blue       - brown
		- cyan       - gray       - green
		- grey       - lime       - magenta
		- maroon     - orange     - purple
		- red        - silver     - white
		- yellow     - (24-bit hex, as "#abcdef")


		Mandatory arguments to long options are mandatory for short options too.
		  --help                    Show this help text.


		Exit Status:
		  0  if OK,
		  1  if invalid option.
	EOF

}

# ---

{ # -- Parameter Processing: Options -- #

	CHAR_OPTS=''
	LONG_OPTS='help'

	set-params
	while true; do
		option="$1" && shift
		case "$option" in
			(--help) help-and-exit ;;
			(--) break ;;  # No more options.
		esac
	done

}

{ # -- Parameter Processing: Positionals -- #

	color="$1" && shift
	case "$color" in
		(''     ) color='#00ffff' ;;
		(black  ) color='#000000' ;;
		(blue   ) color='#0000ff' ;;
		(brown  ) color='#800000' ;;
		(cyan   ) color='#00ffff' ;;
		(gray   ) color='#808080' ;;
		(green  ) color='#008000' ;;
		(grey   ) color='#808080' ;;
		(lime   ) color='#00ff00' ;;
		(magenta) color='#800080' ;;
		(maroon ) color='#800000' ;;
		(orange ) color='#808000' ;;
		(purple ) color='#800080' ;;
		(red    ) color='#ff0000' ;;
		(silver ) color='#c0c0c0' ;;
		(white  ) color='#ffffff' ;;
		(yellow ) color='#ffff00' ;;

		*) [ "${color:0:1}" == '#' ] || user-error 1 'invalid option(s)' ;;
	esac

	[ "$#" == 0 ] || user-error 1 'invalid option(s)'

}

# ---
# ---


cat <<-EOF | store-as host_setup
	# Set the host pane title.
	#
	tmux set set-titles-string ''
EOF

cat <<-EOF | store-as session_setup
	# Don't show a status bar.
	#
	tmux set status off

	# Don't print a pane title.
	#
	tmux set pane-border-format ''

	# Set the pane titlebar color.
	#
	tmux set pane-active-border-style 'fg=${color}'

	# Don't leave the session lingering once the host pane goes away.
	#
	tmux set destroy-unattached on

	# Don't try to load a different session once this one goes away.
	# (This leads to recursively trying to display the current session within smaller and smaller panes.)
	#
	tmux set detach-on-destroy on
EOF

cat <<-EOF | store-as host_reset
	# Clear the host pane title.
	#
	tmux set set-titles-string ''
EOF


TMUX='' tmux new-session "${host_setup} ; ${session_setup} ; bash ; ${host_reset}" &> /dev/null
