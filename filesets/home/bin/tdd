#! /bin/env bash
source '/home/nestor/bin/std.lib'

# ---

{ # -- Help Text -- #

	cat <<-EOF | store-as usage
		Usage: $( script-name ) [-- RUNNER_OPTIONS]

		Run all relevant TDD tooling for the project:
		- Supports Ruby RSpec and Minitest suites, along with Selenium tests.
		- Supports Javascript suites triggered via a "test" action.

		Any RUNNER_OPTIONS given are passed through to the "runner" subtooling.


		Mandatory arguments to long options are mandatory for short options too.
		  --on-completion           'notify' channel to report test completion,
		                            regardless of outcome.
		  --on-fail                 'notify' channel to report test completion,
		                            only in the case of failures.

		  --fails                   Rerun only previously-failed tests.
		  --next                    Stop on the next failure.

		  --help                    Show this help text.


		Exit Status:
		  0  if OK,
		  1  if invalid option.
	EOF

}

# ---

{ # -- Parameter Processing: Options -- #

	# Set default.

	notify_on=''
	notify_channel=''

	declare -A next
	declare -A fails

	# ---
	# ---

	CHAR_OPTS=''
	LONG_OPTS='help'

	LONG_OPTS="${LONG_OPTS},next,stop"
	LONG_OPTS="${LONG_OPTS},fail,fails,failures"
	LONG_OPTS="${LONG_OPTS},on-completion:,on-failure:"

	set-params
	while true; do
		option="$1" && shift
		case "$option" in
			(--help) help-and-exit ;;
			(--) break ;;  # No more options.


			(--on-completion)
				notify_on='completion'
				notify_channel="$1" && shift
				;;

			(--on-failure)
				notify_on='failure'
				notify_channel="$1" && shift
				;;


			(--next|--stop)
				next=( [rspec]='--next-failure' [javascript]='--bail' )
				;;

			(--fail|--fails|--failures)
				fails=( [rspec]='--only-failures' [javascript]='--onlyFailures' )
				;;

		esac
	done

}

# ---
# ---


# Global Behaviours

declare -A exit_codes


# ---


# Ruby Testing


	# Set flags ...

		# Check for RSpec usage.

		nearest --read 'Gemfile.lock' 'Gemfile' | 'has?' 'rspec' && rspec='1'


		# Check for Minitest files.

		rg --quiet minitest test/ &> /dev/null && minitest='1'


	# Run the tests ...

		if [ -n "$rspec" ]; then
			opts=("$@")
			[ -n "${next[rspec]}"  ] && opts+=("${next[rspec]}")
			[ -n "${fails[rspec]}" ] && opts+=("${fails[rspec]}")
			tdd.rspec "${opts[@]}"
			exit_codes[rspec]="$?"
		fi

		if [ -n "$minitest" ]; then
			opts=("$@")
			[ -n "${next[minitest]}"  ] && opts+=("${next[minitest]}")
			[ -n "${fails[minitest]}" ] && opts+=("${fails[minitest]}")
			tdd.minitest "${opts[@]}"
			exit_codes[minitest]="$?"
		fi


# ---


# Javascript Testing


	# Set flags ...

		[ -r 'package.json' ] && json '.scripts.test' < package.json | store-as javascript


	# Run the tests ...

		if [ -n "$javascript" ]; then
			opts=("$@")
			[ -n "${next[javascript]}"  ] && opts+=("${next[javascript]}")
			[ -n "${fails[javascript]}" ] && opts+=("${fails[javascript]}")
			tdd.javascript "${opts[@]}"
			exit_codes[javascript]="$?"
		fi


# ---


# Always notify on completion if the test suite takes long to complete.
# If we weren't given a channel when called, it's safest to use 'pushover'
# since those notifications aren't ephemeral and can be checked from anywhere.
#
if 'calc?' "$( script-duration) >= 300"; then
	notify_on='completion'
	[ -n "$notify_channel" ] || notify_channel='pushover'
fi


# Determine our exit code.
#
tr ' ' "\n" <<< "0 ${exit_codes[*]}" \
| sort --reverse --numeric-sort      \
| head -n1                           \
| store-as max_exit_code

# Set the notification subject.
#
if [ "$max_exit_code" == 0 ]
	then subject="$( script-name ): Success"
	else subject="$( script-name ): Failure"
fi

# Build the notification message.
#
messages=()
for test_type in "${!exit_codes[@]}"; do
	exit_code="${exit_codes["$test_type"]}"

	if [ "$exit_code" == 0 ]
		then messages+=("${test_type}: 🗹")
		else messages+=("${test_type}: 🗷")
	fi
done


# Send requested notification, if any.
#
old_ifs="$IFS"; IFS="$NEWLINE"
case "$notify_on" in

	(completion)
		notify "$notify_channel" "$subject" "${messages[@]}"
		;;

	(failure)
		[ "$max_exit_code" != 0 ] && notify "$notify_channel" "$subject" "${messages[@]}"
		;;

esac
IFS="$old_ifs"
